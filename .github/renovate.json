{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-minor"
  ],
  "description": [
    "Pin every npm specifier (yarn deps:check rejects ranges).",
    "Wait 7 days after publish (matches Yarn npmMinimalAgeGate).",
    "Automerge minor/patch only; majors stay for human review.",
    "CI on renovate/* PRs runs yarn deps:check, yarn deps:audit, and yarn test:coverage."
  ],
  "rangeStrategy": "pin",
  "ignoreTests": false,
  "labels": [
    "dependencies",
    "pr-values:elasticsearch"
  ],
  "automergeSchedule": ["after 8am and before 4pm every weekday"],
  "schedule": ["after 8am and before 12am every weekday"],
  "rebaseWhen": "conflicted",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "prCreation": "immediate"
  },
  "helmv3": {
    "bumpVersion": "patch"
  },
  "regexManagers": [
    {
      "fileMatch": [
        "^Dockerfile$"
      ],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Wait 7 days for npm (matches Yarn npmMinimalAgeGate). Helm/Docker keep their own cadence.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict",
      "prCreation": "not-pending"
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "GOV.UK Frontend needs the fixture/build checklist — do not automerge or group",
      "matchPackageNames": ["govuk-frontend"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["*", "!govuk-frontend"],
      "groupName": "All non-major updates",
      "groupSlug": "all-non-major"
    },
    {
      "matchManagers": ["helmv3"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Helm chart updates",
      "groupSlug": "helm-charts"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Dockerfile updates",
      "groupSlug": "dockerfile"
    },
    {
      "matchPackageNames": ["@playwright/test", "playwright-core", "@axe-core/playwright"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Playwright",
      "groupSlug": "playwright"
    },
    {
      "matchPackagePatterns": ["^allure-"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Allure reporting",
      "groupSlug": "allure"
    },
    {
      "matchPackageNames": ["eslint", "typescript-eslint"],
      "matchPackagePatterns": ["^@eslint/", "^@typescript-eslint/", "^eslint-"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ESLint",
      "groupSlug": "eslint"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchPackagePatterns": ["^@types/"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "TypeScript",
      "groupSlug": "typescript"
    }
  ]
}
