{# Yes/no radios via the official govukRadios macro.
  Optional params: yes/no i18n keys, yesHtml/noHtml conditionals, yesHint/noHint,
  classes, errorMessageText, isPageHeading (default true when title is set),
  legendClasses (default govuk-fieldset__legend--l).
  Pass title and omit a wrapping <fieldset> — govukRadios already emits one. #}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% macro yesNoRadioButton(t, id, name, title, form, description, params) %}
  {% set yes = params.yes if params.yes else 'COMMON.VARIATION.YES' %}
  {% set no = params.no if params.no else 'COMMON.VARIATION.NO' %}
  {% set errors = form.getAllErrors() %}
  {% set legendIsPageHeading = params.isPageHeading if params and params.isPageHeading is defined else true %}
  {% set legendClasses = params.legendClasses if params and params.legendClasses else "govuk-fieldset__legend--l" %}
  {{ govukRadios({
    idPrefix: id,
    name: name,
    classes: params.classes,
    fieldset: {
      legend: {
        text: title,
        isPageHeading: legendIsPageHeading,
        classes: legendClasses
      }
    } if title,
    hint: {
      text: description
    },
    items: [
      {
        value: YesNo.YES,
        checked: true if form.model.option=="yes" else false,
        html: "<span>" + t(yes) + "</span>",
        hint: {
          text: params.yesHint
        },
        conditional:{
        html: params.yesHtml
      }
      },
      {
        value: YesNo.NO,
        checked: true if form.model.option=="no" else false,
        html: "<span>" + t(no) + "</span>",
        hint: {
          text: params.noHint
        },
        conditional:{
        html: params.noHtml
      }
      }
    ],
    errorMessage: {
      html: params.errorMessageText if params and params.errorMessageText else t(form.errorFor(name))
    } if form.hasFieldError(name)
  }) }}
{% endmacro %}
