{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "./address.njk" import addressForm %}
{% set govukVisuallyHidden = 'govuk-!-display-none' %}
{% set govukVisuallyHiddenForAnchor = '' %}
{#
  Postcode lookup. Client JS (`postcode-lookup.js`) binds to:
  `.postcode-container`, `.postcode-val`, `.govuk-error-message`, the Find address
  `button`, and the manual-address `a`. Keep those hooks when changing this macro.
  Find address uses the official button default (`type="submit"`). The lookup
  script calls preventDefault only when JS runs, so it cannot block a no-JS
  submit. Without JS, users enter the address manually (the lookup API returns
  JSON, not a HTML results page).
#}
{% macro postcodeLookupAndAddressForm(t,params) %}
  {% if params.addressType === 'primaryAddress' and params.party.model.primaryAddress %}
    {% if params.party.hasFieldError('primaryAddress') %}
      {% set govukVisuallyHidden = '' %}
      {% set govukVisuallyHiddenForAnchor = 'govuk-!-display-none' %}
    {% else %}
      {% set govukVisuallyHidden = 'govuk-!-display-none' %}
      {% set govukVisuallyHiddenForAnchor = '' %}
    {% endif %}
  {% endif %}
  {% if params.addressType === 'correspondenceAddress' and params.party.model.correspondenceAddress %}
    {% if params.party.hasFieldError('correspondenceAddress') %}
      {% set govukVisuallyHidden = '' %}
      {% set govukVisuallyHiddenForAnchor = 'govuk-!-display-none' %}
    {% else %}
      {% set govukVisuallyHidden = 'govuk-!-display-none' %}
      {% set govukVisuallyHiddenForAnchor = '' %}
    {% endif %}
  {% endif %}
  <div class="postcode-container">
    {{ govukInput({
      id: params.addressType + 'Postcode',
      name: params.addressType + "Postcode",
      classes: "govuk-input--width-10 postcode-val",
      type: "text",
      autocomplete: "postal-code",
      label: {
        text: t('COMMON.POSTCODE.UK_POSTCODE')
      },
      attributes: {
        title: t('COMMON.POSTCODE.UK_POSTCODE')
      },
      formGroup: {
        classes: "govuk-!-margin-bottom-2"
      }
    }) }}
    <div class="govuk-!-display-none govuk-error-message" aria-hidden="true">
      {{ t('ERRORS.ADDRESS_NOT_FOUND') + t('ERRORS.TRY_AGAIN') }}
    </div>
    {{ govukButton({
      text: t('COMMON.POSTCODE.FIND_ADDRESS'),
      classes: "govuk-button--secondary"
    }) }}

    {{ govukSelect({
      id: params.addressType + 'postcodeAddress',
      name: "addressList",
      classes: 'addressList',
      label: {
        text: t('COMMON.POSTCODE.PICK_ADDRESS'),
        classes: 'govuk-visually-hidden'
      }
    }) }}

    <div class="{{ govukVisuallyHiddenForAnchor }}" aria-hidden="{{ govukVisuallyHiddenForAnchor == 'govuk-!-display-none' }}">
      <a aria-controls="enterAddressManually" href="#" class="govuk-body govuk-link">
        {{ t('COMMON.POSTCODE.MANUAL_ADDRESS') }}
      </a>
    </div>
    <div>
      <div class="{{ govukVisuallyHidden }} address-form" aria-hidden="{{ govukVisuallyHidden == 'govuk-!-display-none' }}">
        {{ addressForm(
          t,
          party = params.party,
          addressType = params.addressType,
          addressTitle = params.addressTitle
        ) }}
      </div>
    </div>
  </div>
{% endmacro %}
