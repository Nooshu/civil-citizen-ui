{% extends "claim-details-tpl-dashboard.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "../../../macro/page-title.njk" import setPageTitle %}
{% from "../../../macro/csrf.njk" import csrfProtection %}
{% from "../../../macro/heading-with-caption.njk" import headingWithCaption %}
{% from "../../../macro/button.njk" import addButton %}
{% from "../../../macro/uploaded-files-summary.njk" import uploadedFilesSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{{ setPageTitle(t, 'PAGES.GENERAL_APPLICATION.UPLOAD_DIRECTIONS_ORDER_DOCUMENTS.PAGE_TITLE') }}

{% block nestedContent %}
  {% set errors = "" %}
  {% set  idValue = "selectedFile" %}
  {% if form.hasErrors() %}
    {% set errors = translateErrors(form.getAllErrors(),t)[0] %}
    {% set idValue = errors.fieldName %}
  {% endif %}
  {{ headingWithCaption(t, headerTitle, 'PAGES.UPLOAD_DOCUMENTS.TITLE') }}
  <p class="govuk-body">{{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DIRECTIONS_ORDER_DOCUMENTS.NEED_TO_UPLOAD') }}</p>
  <p class="govuk-body">
      {{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DIRECTIONS_ORDER_DOCUMENTS.IF_NOT_SURE_START') }}
      <a href="{{ directionOrderDocUrl }}" target="_blank">{{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DIRECTIONS_ORDER_DOCUMENTS.COURT_DOCUMENT') }}</a>
      {{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DIRECTIONS_ORDER_DOCUMENTS.IF_NOT_SURE_END') }}
  </p>
  <p class="govuk-body">{{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.DOCUMENT_TYPE_SIZE_WITH_SAVE_FILE') }}</p>
  <form method="post" action="{{ currentUrl }}?_csrf={{ csrf }}" enctype='multipart/form-data' novalidate>
    {{ csrfProtection(csrf) }}
    {% set directionsOrderUploadHtml %}
      {{govukFileUpload({
        id: idValue,
        name: "selectedFile",
        label: {
          html: '<strong>' + t('COMMON.UPLOAD_FILE_LABEL') +'</strong>'
        },
        errorMessage: { text: t(errors.text) } if t(errors.text) else ''
      }) }}
      {{ govukButton({
        id: 'uploadFileButton',
        name: 'action',
        value: 'uploadButton',
        text: t('COMMON.SAVE_FILE'),
        classes: "govuk-button--secondary govuk-!-margin-bottom-0"
      }) }}
    {% endset %}
    {{ govukInsetText({ html: directionsOrderUploadHtml }) }}
    {% if formattedSummary.summaryList.rows.length > 0 %}
      <h2 class="govuk-heading-m">{{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DIRECTIONS_ORDER_DOCUMENTS.UPLOADED_FILES') }}</h2>
      <div class="govuk-section-break--s govuk-section-break--visible"></div>
      {{ uploadedFilesSummary(formattedSummary.summaryList.rows, t('PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.REMOVE_DOC')) }}
    {% endif %}
    <div class="givuk-body govuk-button-group govuk-!-margin-top-8">
      {{ addButton(t, 'CONTINUE', cancelUrl) }}
    </div>
  </form>
{% endblock %}
