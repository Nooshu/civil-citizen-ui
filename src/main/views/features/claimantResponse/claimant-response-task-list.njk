{% extends "claim-details-tpl.njk" %}
{% from "../../macro/page-title.njk" import setPageTitle %}
{% from "../../macro/task-list.njk" import taskListComponent %}

{% block pageTitle %}
  {{ setPageTitle(t, 'PAGES.CLAIMANT_RESPONSE_TASK_LIST.PAGE_TITLE') }}
{% endblock %}

{% block content %}
  <div class="govuk-width-container govuk-!-padding-top-0">

      <div class="govuk-grid-row govuk-!-margin-top-0">
        <div class="govuk-grid-column-two-thirds govuk-!-margin-top-0">
          <h1 class="govuk-heading-l govuk-!-margin-bottom-7">{{ t('PAGES.CLAIMANT_RESPONSE_TASK_LIST.HEADER') }}</h1>
        </div>
        <div class="govuk-grid-column-two-thirds govuk-!-margin-top-0">

          <h2 class="govuk-heading-s govuk-!-margin-bottom-2">{{ t(title) }}</h2>
          <p class="govuk-body">{{ t(description) }}</p>
          <p class="govuk-body govuk-!-margin-bottom-7">
            {{ t('PAGES.TASK_LIST.ALL_ACTIONS_COMPLETED_CHECK_ANSWERS') }}
          </p>

          {{ taskListComponent(taskLists, t) }}
        </div>
      </div>
  </div>
{% endblock %}
