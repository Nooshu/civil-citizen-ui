{% extends "claim-details-tpl-dashboard.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set pageTitle = "UI Preview" %}
{# Flat catalogue index — Design System: do not use breadcrumbs on flat structures. #}
{% set noCrumbs = true %}

{% block nestedContent %}
  {% set bannerHtml %}
    <p class="govuk-notification-banner__heading">UI Preview — no IDAM</p>
    <p class="govuk-body">
      This mode runs with <code class="govuk-!-font-size-16">NODE_ENV=e2eTest</code>:
      login is skipped and the session user is fixture id
      <strong>{{ fixtureUserId }}</strong>.
      Civil-service calls go to WireMock.
    </p>
    <p class="govuk-body govuk-!-margin-bottom-0">
      Use <strong>Ready</strong> links for live Nunjucks renders.
      Extra fixture claims cover full admission, part admission, case progression, a general application, and statement of means.
    </p>
  {% endset %}

  {{ govukNotificationBanner({
    html: bannerHtml,
    type: "important",
    titleText: "UI Preview mode"
  }) }}

  <h1 class="govuk-heading-l">Browse journeys</h1>
  <p class="govuk-body">
    Live Nunjucks pages with fixture data. Start here instead of signing in to IDAM.
  </p>

  {{ govukInsetText({
    text: "Command: yarn start:ui-preview  ·  Stack: compose/ui-preview.yml"
  }) }}

  {% for group in catalog %}
    <h2 class="govuk-heading-m">{{ group.title }}</h2>
    <p class="govuk-body">{{ group.description }}</p>

    {% set pageRows = [] %}
    {% for page in group.pages %}
      {% set pageCell %}
        <a class="govuk-link" href="{{ page.path }}">{{ page.title }}</a>
        <br>
        <span class="govuk-hint govuk-!-font-size-16">{{ page.path }}</span>
      {% endset %}
      {% set statusCell %}
        {% if page.status == 'ready' %}
          {{ govukTag({ text: "Ready", classes: "govuk-tag--green" }) }}
        {% else %}
          {{ govukTag({ text: "Stub", classes: "govuk-tag--grey" }) }}
        {% endif %}
      {% endset %}
      {% set pageRows = (pageRows.push([
        {html: pageCell},
        {html: statusCell},
        {text: page.notes or "—"}
      ]), pageRows) %}
    {% endfor %}
    {{ govukTable({
      caption: group.title,
      captionClasses: "govuk-visually-hidden",
      head: [
        {text: "Page"},
        {text: "Status"},
        {text: "Notes"}
      ],
      rows: pageRows
    }) }}
  {% endfor %}
{% endblock %}
