{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": ".",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "es6",
    "strict": false,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "ignoreDeprecations": "6.0",
    "types": ["*"],
    "lib": [
      "es6",
      "es2017.object",
      "dom"
    ],
    "baseUrl": "src/main",
    "paths": {
      "common/*": [
        "common/*"
      ],
      "models/*": [
        "common/models/*"
      ],
      "form/*": [
        "common/form/*"
      ],
      "modules/*": [
        "modules/*"
      ],
      "client/*": [
        "app/client/*"
      ],
      "routes/*": [
        "routes/*"
      ],
      "services/*": [
        "services/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./typings"
    ]
  },
  "include": [
    "src/main/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/test",
    "src/integration-test",
    "playwright",
    "webpack"
  ]
}
